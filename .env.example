# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: gemini | openai | ollama
LLM_PROVIDER=gemini

# ── API Keys ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=""
# OPENAI_API_KEY=your_openai_api_key_here   # Only needed if LLM_PROVIDER=openai

# ── Model Names ───────────────────────────────────────────────────────────────
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── File Paths ────────────────────────────────────────────────────────────────
CV_FILE_PATH=data/cv.pdf
FAISS_INDEX_PATH=data/faiss_index
OUTPUT_DIR=output

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6

# Maximum FAISS L2 distance to consider a chunk relevant (lower = closer match).
# This MUST be calibrated against your actual CV + embedding model:
#   1. Run a known-answer query and inspect the logged best_score.
#   2. Run an unrelated query (e.g. "passport number") and inspect its best_score.
#   3. Set the threshold between the two clusters.
# Default 1.0 is a starting point — adjust based on your observed scores.
RETRIEVAL_SCORE_THRESHOLD=1.0

# ── Agent Behaviour ───────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=5
TEMPERATURE=0.0

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE=output/agent.log
